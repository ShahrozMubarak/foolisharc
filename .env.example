# Server-only environment variables. Never prefix secrets with VITE_.
PORT=5000
NODE_ENV=development

# MongoDB Atlas (use a dedicated database user for this app).
MONGODB_URI=
MONGODB_DB_NAME=zaytoun_atelier

# Owner Studio authentication.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Exact deployed storefront origin, e.g. https://your-store.example
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=

# Optional email delivery. No provider is used unless configured.
ADMIN_NOTIFICATION_EMAIL=
RESEND_API_KEY=
RESEND_FROM=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Optional manual payment methods. A method appears only when both values are set.
PAYMENT_JAZZCASH_ACCOUNT_NUMBER=
PAYMENT_JAZZCASH_ACCOUNT_TITLE=
PAYMENT_EASYPAISA_ACCOUNT_NUMBER=
PAYMENT_EASYPAISA_ACCOUNT_TITLE=

# Optional courier label used by the admin approval flow.
DEFAULT_COURIER=Courier partner

# Public Google Identity Services client ID (safe to expose in the browser).
VITE_GOOGLE_CLIENT_ID=

# Server secret for Google redirect sign-in
GOOGLE_CLIENT_SECRET=
# Trusted proxy address or CIDR for self-hosted deployments
TRUST_PROXY=
