@@ -0,0 +1,11 @@
+export const FREE_SHIPPING_THRESHOLD = 15000;
+export function priceOrder(subtotal) {
+  const shippingFee =
+    subtotal > 0 && subtotal < FREE_SHIPPING_THRESHOLD ? 250 : 0;
+  return {
+    subtotal,
+    shippingFee,
+    discountAmount: 0,
+    finalTotal: subtotal + shippingFee,
+  };
+}
diff --git a/tests/integration/orders.test.js b/tests/integration/orders.test.js
new file mode 100644
index 0000000..dcaa83e
--- /dev/null
+++ b/tests/integration/orders.test.js
@@ -0,0 +1,149 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { randomUUID } from 'node:crypto';
+import mongoose from 'mongoose';
+
+// Separate opt-in test. It creates and removes a uniquely named test database.
+test('order integrity and fit profile ownership on a replica set', async () => {
+  if (!process.env.TEST_MONGODB_URI)
+    throw new Error('Set TEST_MONGODB_URI to a disposable test replica set.');
+  process.env.NODE_ENV = 'test';
+  process.env.MONGODB_URI = process.env.TEST_MONGODB_URI;
+  process.env.MONGODB_DB_NAME =
+    'foolisharc_test_' + randomUUID().replaceAll('-', '');
+  for (const key of [
+    'RESEND_API_KEY',
+    'EMAIL_USER',
+    'EMAIL_PASS',
+    'ADMIN_NOTIFICATION_EMAIL',
+    'ADMIN_EMAIL',
+  ])
+    process.env[key] = '';
+  const { default: app } = await import('../../server/index.js');
+  const { connectDB } = await import('../../server/db.js');
+  const { default: Product } = await import('../../server/models/Product.js');
+  const { default: Order } = await import('../../server/models/Order.js');
+  const { default: Customer } = await import('../../server/models/Customer.js');
+  const { default: FitProfile } = await import(
+    '../../server/models/FitProfile.js'
+  );
+  let server;
+  try {
+    assert.ok(await connectDB());
+    await Promise.all([
+      Product.init(),
+      Order.init(),
+      Customer.init(),
+      FitProfile.init(),
+    ]);
+    server = await new Promise((resolve) => {
+      const s = app.listen(0, '127.0.0.1', () => resolve(s));
+    });
+    const base = 'http://127.0.0.1:' + server.address().port + '/api';
+    const request = (path, method = 'GET', body, cookie) =>
+      fetch(base + path, {
+        method,
+        headers: {
+          'Content-Type': 'application/json',
+          ...(cookie ? { Cookie: cookie } : {}),
+        },
+        body: body ? JSON.stringify(body) : undefined,
+      });
+    const products = await (await request('/products')).json();
+    const p = products.find((p) => p.id === 'forme-01'),
+      size = 'M',
+      start = p.stockPerSize[size];
+    const stock = async () =>
+      (await Product.findOne({ id: p.id }).lean()).stockPerSize[size];
+    const order = {
+      idempotencyKey: randomUUID(),
+      customer: {
+        firstName: 'Test',
+        email: 'shopper@example.test',
+        phone: '03001234567',
+        address: 'Test Street 10',
+        city: 'Lahore',
+      },
+      paymentMethod: 'cod',
+      items: [{ id: p.id, size, quantity: 1, price: 1 }],
+    };
+    const bad = await request('/orders', 'POST', {
+      ...order,
+      idempotencyKey: randomUUID(),
+      items: [...order.items, { id: 'missing', size, quantity: 1 }],
+    });
+    assert.equal(bad.status, 409);
+    assert.equal(await stock(), start);
+    assert.equal(await Order.countDocuments(), 0);
+    const replies = await Promise.all([
+      request('/orders', 'POST', order),
+      request('/orders', 'POST', order),
+    ]);
+    assert.deepEqual(replies.map((r) => r.status).sort(), [200, 201]);
+    const [a, b] = await Promise.all(replies.map((r) => r.json()));
+    assert.equal(a.orderNumber, b.orderNumber);
+    assert.equal(a.total, p.price);
+    assert.equal(await stock(), start - 1);
+    assert.equal(a.idempotencyKey, undefined);
+    assert.equal(a.requestHash, undefined);
+    assert.equal(
+      (await Customer.findOne({ email: order.customer.email })).ordersCount,
+      1,
+    );
+    assert.equal(
+      (
+        await request('/orders', 'POST', {
+          ...order,
+          customer: { ...order.customer, email: 'other@example.test' },
+        })
+      ).status,
+      409,
+    );
+    const track = '/orders/' + a.orderNumber;
+    assert.equal(
+      (await request(track + '?email=wrong@example.test')).status,
+      404,
+    );
+    assert.equal(
+      (await request(track + '?email=shopper@example.test')).status,
+      200,
+    );
+    const cancel = () =>
+      request(track + '/cancel', 'POST', { email: order.customer.email });
+    const cancellations = await Promise.all([cancel(), cancel()]);
+    assert.deepEqual(cancellations.map((r) => r.status).sort(), [200, 409]);
+    assert.equal(await stock(), start);
+    const saved = await request('/fit/profile', 'POST', {
+      chest: 94,
+      consentGiven: true,
+    });
+    assert.equal(saved.status, 201);
+    const cookie = saved.headers.getSetCookie()[0].split(';')[0];
+    assert.deepEqual(
+      await (
+        await request('/fit/profile?guestToken=' + cookie.split('=')[1])
+      ).json(),
+      { profile: null },
+    );
+    assert.equal(
+      (await (await request('/fit/profile', 'GET', null, cookie)).json())
+        .profile.measurements.chestCm,
+      94,
+    );
+    await request('/fit/profile?guestToken=' + cookie.split('=')[1], 'DELETE');
+    assert.equal(await FitProfile.countDocuments(), 1);
+    assert.equal(
+      (await request('/fit/profile', 'DELETE', null, cookie)).status,
+      200,
+    );
+    assert.equal(await FitProfile.countDocuments(), 0);
+  } finally {
+    if (server) await new Promise((resolve) => server.close(resolve));
+    if (
+      mongoose.connection.readyState === 1 &&
+      mongoose.connection.name === process.env.MONGODB_DB_NAME
+    )
+      await mongoose.connection.dropDatabase();
+    await mongoose.disconnect();
+  }
+});
diff --git a/tests/security/repairs.test.js b/tests/security/repairs.test.js
new file mode 100644
index 0000000..56e4bf3
--- /dev/null
+++ b/tests/security/repairs.test.js
@@ -0,0 +1,152 @@
+import test, { before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { randomBytes } from 'node:crypto';
+import bcrypt from 'bcryptjs';
+import { garment, thumb } from '../../src/engine/formeEngine.js';
+import { recommendProductSize } from '../../src/engine/fitFinderEngine.js';
+import { PRODUCTS } from '../../src/data/products.js';
+import { priceOrder } from '../../src/utils/pricing.js';
+
+process.env.NODE_ENV = 'test';
+process.env.MONGODB_URI = '';
+process.env.PUBLIC_APP_URL = 'https://store.example.test';
+process.env.ADMIN_EMAIL = 'owner@example.test';
+const password = randomBytes(20).toString('hex');
+process.env.ADMIN_PASSWORD_HASH = await bcrypt.hash(password, 4);
+process.env.JWT_SECRET = randomBytes(48).toString('hex');
+const { default: app } = await import('../../server/index.js');
+let server, base;
+before(async () => {
+  server = await new Promise((resolve) => {
+    const s = app.listen(0, '127.0.0.1', () => resolve(s));
+  });
+  base = 'http://127.0.0.1:' + server.address().port;
+});
+after(() => new Promise((resolve) => server.close(resolve)));
+const post = (path, body, headers) =>
+  fetch(base + path, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json', ...headers },
+    body: JSON.stringify(body),
+  });
+
+test('admin writes require the token issued for that exact session', async () => {
+  async function login() {
+    const r = await post('/api/auth/login', {
+      email: process.env.ADMIN_EMAIL,
+      password,
+    });
+    assert.equal(r.status, 200);
+    return {
+      cookie: r.headers.getSetCookie()[0].split(';')[0],
+      csrf: (await r.json()).csrfToken,
+    };
+  }
+  const a = await login(),
+    b = await login();
+  for (const headers of [
+    {},
+    { 'X-Requested-With': 'XMLHttpRequest' },
+    { 'X-CSRF-Token': b.csrf },
+  ])
+    assert.equal(
+      (
+        await post(
+          '/api/theme',
+          { brand: 'Demo' },
+          { Cookie: a.cookie, ...headers },
+        )
+      ).status,
+      403,
+    );
+  assert.equal(
+    (
+      await post(
+        '/api/theme',
+        { brand: 'Demo' },
+        { Cookie: a.cookie, 'X-CSRF-Token': a.csrf },
+      )
+    ).status,
+    503,
+  );
+});
+test('anonymous order list is private', async () =>
+  assert.equal((await fetch(base + '/api/orders')).status, 401));
+test('origin, request encoding and payload limits', async () => {
+  assert.equal(
+    (
+      await post(
+        '/api/auth/customer-logout',
+        {},
+        { Origin: 'https://store.example.test.evil.test' },
+      )
+    ).status,
+    403,
+  );
+  assert.equal(
+    (
+      await fetch(base + '/api/auth/customer-logout', {
+        method: 'POST',
+        body: 'form',
+      })
+    ).status,
+    415,
+  );
+  assert.equal(
+    (await post('/api/inquiries', { message: 'x'.repeat(40000) })).status,
+    413,
+  );
+});
+test('profile consent and storage outage', async () => {
+  assert.equal((await post('/api/fit/profile', { chest: 93 })).status, 400);
+  assert.equal(
+    (await post('/api/fit/profile', { chest: 93, consentGiven: true })).status,
+    503,
+  );
+  assert.deepEqual(
+    await (
+      await fetch(base + '/api/fit/profile?guestToken=someone-else')
+    ).json(),
+    { profile: null },
+  );
+});
+test('anonymous rate limiting ignores untrusted forwarded addresses', async () => {
+  let r;
+  for (let i = 0; i < 7; i++)
+    r = await post('/api/inquiries', {}, { 'X-Forwarded-For': '192.0.2.' + i });
+  assert.equal(r.status, 429);
+  assert.ok(Number(r.headers.get('retry-after')) > 0);
+});
+test('fit chart handles centimetres, inches and no matching size', () => {
+  const p = PRODUCTS.find((p) => p.person === 'women' && p.slot === 'top');
+  assert.equal(recommendProductSize({ chest: 93 }, p).recommendedSize, 'M');
+  assert.equal(
+    recommendProductSize({ chest: 93 / 2.54, measurementUnit: 'in' }, p)
+      .recommendedSize,
+    'M',
+  );
+  assert.equal(recommendProductSize({ chest: 165 }, p).recommendedSize, null);
+});
+test('fitting-room SVG does not execute catalogue markup', () => {
+  const p = {
+    person: 'women',
+    slot: 'top',
+    style: 'shirt',
+    colors: [{ hex: '"><script>alert(1)</script>' }],
+  };
+  assert.doesNotMatch(garment(p), /<script|onerror=/);
+  p.style = 'custom';
+  p.asset = {
+    src: 'javascript:alert(1)',
+    x: 0,
+    y: 0,
+    width: '10" onerror="x',
+    height: 10,
+  };
+  assert.doesNotMatch(thumb(p), /javascript:|onerror=/);
+});
+test('bag and server share the free-shipping boundary', () => {
+  assert.equal(priceOrder(0).shippingFee, 0);
+  assert.equal(priceOrder(14999).finalTotal, 15249);
+  assert.equal(priceOrder(15000).finalTotal, 15000);
+});
