diff --git a/server/services/fitRoutes.js b/server/services/fitRoutes.js
new file mode 100644
index 0000000..6e7dd2f
--- /dev/null
+++ b/server/services/fitRoutes.js
@@ -0,0 +1,95 @@
+import { createHash, randomBytes } from 'node:crypto';
+import { Router } from 'express';
+import FitProfile from '../models/FitProfile.js';
+import FitFeedback from '../models/FitFeedback.js';
+import { connectDB } from '../db.js';
+import { normalizeFitInputs } from '../../src/engine/fitFinderEngine.js';
+import { parseCookie, verifyCustomerSession } from '../middleware/auth.js';
+import { createRateLimiter } from '../middleware/rateLimiter.js';
+import {
+  validateFitProfile,
+  validateFitFeedback,
+} from '../middleware/validation.js';
+const router = Router();
+const key = 'foolisharc_fit_guest';
+const options = {
+  httpOnly: true,
+  secure: process.env.NODE_ENV === 'production',
+  sameSite: 'strict',
+  path: '/api',
+};
+function ownerFor(req, res, create = false) {
+  const user = verifyCustomerSession(req);
+  if (user) return 'account:' + user.email;
+  let token = parseCookie(req, key);
+  if (!/^[0-9a-f]{64}$/.test(token)) {
+    if (!create) return null;
+    token = randomBytes(32).toString('hex');
+    res.cookie(key, token, { ...options, maxAge: 90 * 86400000 });
+  }
+  return 'guest:' + createHash('sha256').update(token).digest('hex');
+}
+router.post(
+  '/profile',
+  createRateLimiter({ max: 30 }),
+  validateFitProfile,
+  async (req, res) => {
+    const measurements = normalizeFitInputs(req.body);
+    if (!Object.values(measurements).some(Number.isFinite))
+      return res
+        .status(400)
+        .json({ error: 'Enter a measurement before saving.' });
+    if (!(await connectDB()))
+      return res
+        .status(503)
+        .json({ error: 'Measurements could not be saved. Try again later.' });
+    const profile = {
+      measurements,
+      fitPreference: req.body.fitPreference,
+      consentGiven: true,
+    };
+    await FitProfile.updateOne(
+      { owner: ownerFor(req, res, true) },
+      { $set: profile },
+      { upsert: true, runValidators: true },
+    );
+    return res.status(201).json({ profile });
+  },
+);
+router.get('/profile', async (req, res) => {
+  const owner = ownerFor(req, res);
+  if (!owner) return res.json({ profile: null });
+  if (!(await connectDB()))
+    return res.status(503).json({ error: 'Saved measurements unavailable.' });
+  return res.json({
+    profile: await FitProfile.findOne({ owner })
+      .select('measurements fitPreference -_id')
+      .lean(),
+  });
+});
+router.delete('/profile', async (req, res) => {
+  const owner = ownerFor(req, res);
+  if (owner) {
+    if (!(await connectDB()))
+      return res
+        .status(503)
+        .json({
+          error: 'Unable to delete your measurements. Try again later.',
+        });
+    await FitProfile.deleteOne({ owner });
+    if (owner.startsWith('guest:')) res.clearCookie(key, options);
+  }
+  return res.json({ deleted: true });
+});
+router.post(
+  '/feedback',
+  createRateLimiter({ max: 30 }),
+  validateFitFeedback,
+  async (req, res) => {
+    if (!(await connectDB()))
+      return res.status(503).json({ error: 'Feedback could not be saved.' });
+    const saved = await FitFeedback.create(req.body);
+    return res.status(201).json({ success: true, feedbackId: saved._id });
+  },
+);
+export default router;
diff --git a/server/services/googleProfile.js b/server/services/googleProfile.js
new file mode 100644
index 0000000..8eaa89b
--- /dev/null
+++ b/server/services/googleProfile.js
@@ -0,0 +1,49 @@
+import { OAuth2Client } from 'google-auth-library';
+const google = new OAuth2Client();
+export const googleClientId = () =>
+  process.env.GOOGLE_CLIENT_ID || process.env.VITE_GOOGLE_CLIENT_ID || '';
+const fail = (status, message) => Object.assign(new Error(message), { status });
+function profile(claims) {
+  if (claims?.email_verified !== true || !claims.email || !claims.sub)
+    throw fail(401, 'A verified Google account is required.');
+  const email = claims.email.trim().toLowerCase(),
+    name = (claims.name || email.split('@')[0]).slice(0, 100);
+  return {
+    email,
+    name,
+    firstName: (claims.given_name || name.split(' ')[0]).slice(0, 70),
+    lastName: (claims.family_name || '').slice(0, 70),
+    avatar: (claims.picture || '').slice(0, 1000),
+    googleId: claims.sub,
+  };
+}
+export async function profileFromIdToken(token) {
+  const ticket = await google
+    .verifyIdToken({ idToken: token, audience: googleClientId() })
+    .catch(() => null);
+  return profile(ticket?.getPayload());
+}
+export async function getVerifiedGoogleProfile(token) {
+  if (!googleClientId()) throw fail(503, 'Google sign-in is not configured.');
+  if (typeof token !== 'string' || token.length < 20 || token.length > 4096)
+    throw fail(401, 'Invalid sign-in.');
+  const info = await google.getTokenInfo(token).catch(() => null);
+  if (
+    !info ||
+    (info.azp || info.aud) !== googleClientId() ||
+    !(info.expiry_date > Date.now())
+  )
+    throw fail(401, 'Google could not verify this sign-in for this store.');
+  const response = await fetch(
+    'https://www.googleapis.com/oauth2/v3/userinfo',
+    {
+      headers: { Authorization: 'Bearer ' + token },
+      signal: AbortSignal.timeout(7000),
+    },
+  );
+  if (!response.ok) throw fail(401, 'Google could not verify this account.');
+  const verified = profile(await response.json());
+  if (info.sub && info.sub !== verified.googleId)
+    throw fail(401, 'Invalid account.');
+  return verified;
+}
