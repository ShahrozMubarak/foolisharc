{
  "name": "foolisharc-storefront",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "db:view": "node server/viewData.js",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "admin:hash": "node scripts/hash-admin-password.js",
    "test": "node --test tests/e2e/tier1_features/*.test.js tests/security/*.test.js",
    "check": "npm test && npm run build",
    "test:db": "node --test tests/integration/orders.test.js"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.6.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.2",
    "joi": "^18.3.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "nodemailer": "^10.2.0",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.6",
    "resend": "^6.34.1",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  },
  "overrides": {
    "body-parser": "^2.4.0"
  }
}
